<Window x:Class="Cardex.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Cardex.Converters"
        xmlns:vm="clr-namespace:Cardex.ViewModels"
        Title="Settings"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e"
        Foreground="#e0e0e0"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StrEq"/>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8888aa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#16213e"/>
                                <Setter Property="Foreground" Value="#e0e0e0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#e0e0e0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutKeyStyle" TargetType="Border">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <TabControl Background="Transparent" BorderThickness="0"
                Margin="0,8,0,0">
        <TabControl.Resources>
            <Style TargetType="TabPanel">
                <Setter Property="Background" Value="#0f3460"/>
            </Style>
        </TabControl.Resources>

        <!-- ===== ONGLET OPTIONS ===== -->
        <TabItem Header="Options" Style="{StaticResource TabItemStyle}">
            <StackPanel Margin="24,20,24,16">

                <TextBlock Text="Collection border color"
                           Foreground="#8888aa" FontSize="12"
                           Margin="0,0,0,12"/>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#3a7fc1"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#3a7fc1" BorderThickness="2" ToolTip="Sky Blue">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#3a7fc1}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#1565c0"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#1565c0" BorderThickness="2" ToolTip="Navy Blue">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#1565c0}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#3f51b5"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#3f51b5" BorderThickness="2" ToolTip="Indigo">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#3f51b5}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#00bcd4"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#00bcd4" BorderThickness="2" ToolTip="Cyan">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#00bcd4}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#4ecdc4"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#4ecdc4" BorderThickness="2" ToolTip="Teal">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#4ecdc4}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#27ae60"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#27ae60" BorderThickness="2" ToolTip="Green">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#27ae60}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#8bc34a"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#8bc34a" BorderThickness="2" ToolTip="Lime">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#8bc34a}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#f1c40f"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#f1c40f" BorderThickness="2" ToolTip="Yellow">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#f1c40f}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#e67e22"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#e67e22" BorderThickness="2" ToolTip="Orange">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#e67e22}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#e74c3c"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#e74c3c" BorderThickness="2" ToolTip="Red">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#e74c3c}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#e91e8c"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#e91e8c" BorderThickness="2" ToolTip="Pink">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#e91e8c}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#8e44ad"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#8e44ad" BorderThickness="2" ToolTip="Purple">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#8e44ad}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#95a5a6"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#95a5a6" BorderThickness="2" ToolTip="Gray">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#95a5a6}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetBorderColorCommand}" CommandParameter="#ecf0f1"
                            Style="{StaticResource SwatchBtnStyle}" Margin="3">
                        <Border Width="28" Height="28" CornerRadius="5" Background="#ecf0f1" BorderThickness="2" ToolTip="White">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Value="True" Binding="{Binding CollectionBorderColor, Converter={StaticResource StrEq}, ConverterParameter=#ecf0f1}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                    </Button>
                </WrapPanel>

                <Rectangle Height="1" Fill="#0f3460" Margin="0,0,0,16"/>

                <CheckBox IsChecked="{Binding ShowMyCollection}"
                          Content="Show My Collection tab"
                          Foreground="#e0e0e0" FontSize="12" Cursor="Hand"/>

                <Rectangle Height="1" Fill="#0f3460" Margin="0,16,0,16"/>

                <TextBlock Text="Achievement sound"
                           Foreground="#8888aa" FontSize="12" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SetAchievementSoundCommand}" CommandParameter="xbox"
                            Style="{StaticResource SwatchBtnStyle}" Margin="0,0,8,0">
                        <Border Padding="12,6" CornerRadius="4" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#111122"/>
                                    <Setter Property="BorderBrush" Value="#0f3460"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding AchievementSound, Converter={StaticResource StrEq}, ConverterParameter=xbox}">
                                            <Setter Property="BorderBrush" Value="#ffd700"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="🎮 Xbox" Foreground="#e0e0e0" FontSize="12"/>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetAchievementSoundCommand}" CommandParameter="ps4"
                            Style="{StaticResource SwatchBtnStyle}" Margin="0,0,8,0">
                        <Border Padding="12,6" CornerRadius="4" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#111122"/>
                                    <Setter Property="BorderBrush" Value="#0f3460"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding AchievementSound, Converter={StaticResource StrEq}, ConverterParameter=ps4}">
                                            <Setter Property="BorderBrush" Value="#ffd700"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="🎮 PS4" Foreground="#e0e0e0" FontSize="12"/>
                        </Border>
                    </Button>
                    <Button Command="{Binding SetAchievementSoundCommand}" CommandParameter="none"
                            Style="{StaticResource SwatchBtnStyle}">
                        <Border Padding="12,6" CornerRadius="4" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#111122"/>
                                    <Setter Property="BorderBrush" Value="#0f3460"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding AchievementSound, Converter={StaticResource StrEq}, ConverterParameter=none}">
                                            <Setter Property="BorderBrush" Value="#ffd700"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="🔇 None" Foreground="#e0e0e0" FontSize="12"/>
                        </Border>
                    </Button>
                </StackPanel>

            </StackPanel>
        </TabItem>

        <!-- ===== ONGLET MY TAGS ===== -->
        <TabItem Header="My Tags" Style="{StaticResource TabItemStyle}">
            <Grid Margin="24,20,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Création d'un nouveau tag -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="New tag" Foreground="#8888aa" FontSize="12" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#111122" Foreground="#e0e0e0"
                                 CaretBrush="#e0e0e0" BorderBrush="#0f3460"
                                 Padding="8,5" FontSize="12">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <!-- Pastille couleur sélectionnée -->
                        <Border Grid.Column="2" Width="20" Height="20" CornerRadius="4"
                                Background="{Binding PendingTagBrush}"
                                VerticalAlignment="Center"/>
                        <Button Grid.Column="4"
                                Command="{Binding AddTagCommand}"
                                Content="Add"
                                Background="#16213e" Foreground="#e0e0e0"
                                BorderBrush="#0f3460" Padding="14,5"
                                FontSize="12" Cursor="Hand"/>
                    </Grid>

                    <!-- Palette de couleurs -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#3a7fc1" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#3a7fc1" BorderThickness="2" ToolTip="Sky Blue">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#3a7fc1}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#1565c0" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#1565c0" BorderThickness="2" ToolTip="Navy Blue">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#1565c0}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#4ecdc4" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#4ecdc4" BorderThickness="2" ToolTip="Teal">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#4ecdc4}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#27ae60" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#27ae60" BorderThickness="2" ToolTip="Green">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#27ae60}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#8bc34a" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#8bc34a" BorderThickness="2" ToolTip="Lime">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#8bc34a}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#f1c40f" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#f1c40f" BorderThickness="2" ToolTip="Yellow">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#f1c40f}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#e67e22" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#e67e22" BorderThickness="2" ToolTip="Orange">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#e67e22}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#e74c3c" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#e74c3c" BorderThickness="2" ToolTip="Red">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#e74c3c}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#e91e8c" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#e91e8c" BorderThickness="2" ToolTip="Pink">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#e91e8c}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#8e44ad" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#8e44ad" BorderThickness="2" ToolTip="Purple">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#8e44ad}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#95a5a6" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#95a5a6" BorderThickness="2" ToolTip="Gray">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#95a5a6}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                        <Button Command="{Binding SelectNewTagColorCommand}" CommandParameter="#ecf0f1" Style="{StaticResource SwatchBtnStyle}" Margin="3">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#ecf0f1" BorderThickness="2" ToolTip="White">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers><DataTrigger Value="True" Binding="{Binding PendingTagColor, Converter={StaticResource StrEq}, ConverterParameter=#ecf0f1}"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers>
                                </Style></Border.Style>
                            </Border>
                        </Button>
                    </WrapPanel>

                    <Rectangle Height="1" Fill="#0f3460" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Liste des tags existants -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                <StackPanel Margin="0,4,0,8">
                                    <!-- Nom + boutons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="14" Height="14" CornerRadius="3"
                                                Background="{Binding Brush}"
                                                VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#111122" Foreground="#e0e0e0"
                                                 CaretBrush="#e0e0e0" BorderBrush="#0f3460"
                                                 Padding="6,3" FontSize="12" Margin="8,0,6,0">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.UpdateTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="✓" ToolTip="Save"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#27ae60" FontSize="14"
                                                Padding="4,2" Cursor="Hand"/>
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="✕" ToolTip="Delete"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#8888aa" FontSize="12"
                                                Padding="6,2" Cursor="Hand"/>
                                    </Grid>
                                    <!-- Palette couleur -->
                                    <WrapPanel Orientation="Horizontal" Margin="20,5,0,0">
                                        <Button Command="{Binding SetColorCommand}" CommandParameter="#3a7fc1" Style="{StaticResource SwatchBtnStyle}" Margin="2">
                                            <Border Width="16" Height="16" CornerRadius="3" Background="#3a7fc1" BorderThickness="2">
                                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
