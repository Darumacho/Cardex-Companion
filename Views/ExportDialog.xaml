<Window x:Class="Cardex.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export CSV"
        Width="320" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e"
        Foreground="#e0e0e0">

    <StackPanel Margin="24,20,24,16">
        <TextBlock Text="What do you want to export?"
                   Foreground="#8888aa" FontSize="12"
                   Margin="0,0,0,16"/>

        <RadioButton x:Name="RadioCollection"
                     Content="My Collection"
                     IsChecked="True"
                     Foreground="#e0e0e0" FontSize="12"
                     Margin="0,0,0,10" Cursor="Hand"/>

        <RadioButton x:Name="RadioWants"
                     Content="Wants"
                     Foreground="#e0e0e0" FontSize="12"
                     Margin="0,0,0,10" Cursor="Hand"/>

        <RadioButton x:Name="RadioDuplicates"
                     Content="Duplicates"
                     Foreground="#e0e0e0" FontSize="12"
                     Margin="0,0,0,20" Cursor="Hand"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="30"
                    Margin="0,0,8,0" IsCancel="True"
                    Background="#0f3460" Foreground="#e0e0e0"
                    BorderBrush="#0f3460" Cursor="Hand"
                    Click="Cancel_Click"/>
            <Button Content="Export" Width="80" Height="30"
                    IsDefault="True"
                    Background="#27ae60" Foreground="#e0e0e0"
                    BorderBrush="#27ae60" Cursor="Hand"
                    Click="Export_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
