<Window x:Class="Cardex.Views.CardZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Card Zoom"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111122"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <StackPanel Margin="16">
        <!-- Image -->
        <Border CornerRadius="8" ClipToBounds="True">
            <Grid>
                <TextBlock x:Name="LoadingText" Text="Loading…"
                           Foreground="#8888aa" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="40"/>
                <Image x:Name="CardImage"
                       MaxWidth="480" MaxHeight="670"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>

        <!-- Infos -->
        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="CardName"
                       Foreground="#e0e0e0" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="CardDetails"
                       Foreground="#8888aa" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <TextBlock Text="Click anywhere or press Esc to close"
                   Foreground="#44445a" FontSize="10"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
