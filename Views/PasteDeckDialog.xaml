<Window x:Class="Cardex.Views.PasteDeckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import decklist"
        Width="440" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e"
        Foreground="#e0e0e0">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Deck name"
                   Foreground="#8888aa" FontSize="12"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="DeckNameBox" Grid.Row="1"
                 Text="Imported Deck"
                 Background="#111122" Foreground="#e0e0e0"
                 CaretBrush="#e0e0e0"
                 BorderBrush="#0f3460" BorderThickness="1"
                 Padding="8,5" FontSize="12"
                 Margin="0,0,0,14"/>

        <TextBlock Grid.Row="2"
                   Text="Paste a decklist copied from Limitless TCG, TCGPlayer, Pokémon TCG Live, etc. (PTCGO/PTCGL text format)"
                   Foreground="#8888aa" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="DeckTextBox" Grid.Row="3"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="#111122" Foreground="#e0e0e0"
                 CaretBrush="#e0e0e0"
                 BorderBrush="#0f3460" BorderThickness="1"
                 Padding="8,6" FontSize="12" FontFamily="Consolas"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Height="30"
                    Margin="0,0,8,0" IsCancel="True"
                    Background="#0f3460" Foreground="#e0e0e0"
                    BorderBrush="#0f3460" Cursor="Hand"
                    Click="Cancel_Click"/>
            <Button Content="Import" Width="80" Height="30"
                    IsDefault="True"
                    Background="#27ae60" Foreground="#e0e0e0"
                    BorderBrush="#27ae60" Cursor="Hand"
                    Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
