<UserControl x:Class="Cardex.Views.DeckBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Cardex.ViewModels"
             xmlns:conv="clr-namespace:Cardex.Converters"
             Background="{StaticResource BrushBg}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:WrapRowWidthConverter x:Key="WrapRowWidthConverter"/>
        <conv:ImageUrlToBitmapConverter x:Key="ImageUrlToBitmap"/>

        <!-- Compact dark button -->
        <Style x:Key="DkBtn" TargetType="Button">
            <Setter Property="Background"      Value="#0f3460"/>
            <Setter Property="Foreground"      Value="#e0e0e0"/>
            <Setter Property="BorderBrush"     Value="#1a4a80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1a4a80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Admin icon button -->
        <Style x:Key="AdminBtn" TargetType="Button" BasedOn="{StaticResource DkBtn}">
            <Setter Property="Width"   Value="26"/>
            <Setter Property="Height"  Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Chip badge -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="5,2"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Background"      Value="#0f1629"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LEFT (of this view) : Recherche de cartes                        -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{StaticResource BrushBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushAccent}" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding CardSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#111122" Foreground="{StaticResource BrushText}"
                                 CaretBrush="{StaticResource BrushText}"
                                 BorderBrush="#0f3460" BorderThickness="1"
                                 Padding="8,5" FontSize="12">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCardsCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="Search cards by name…"
                                   Foreground="{StaticResource BrushSubtext}"
                                   FontSize="12" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Command="{Binding SearchCardsCommand}"
                            Style="{StaticResource DkBtn}" Margin="6,0,0,0">
                        🔍 Search
                    </Button>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border Grid.Row="1" Background="{StaticResource BrushPanel}" Padding="10,6"
                    BorderBrush="{StaticResource BrushAccent}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <!-- Supertype filter -->
                    <ComboBox ItemsSource="{x:Static vm:DeckBuilderViewModel.SupertypeOptions}"
                              SelectedItem="{Binding SupertypeFilter}"
                              Width="90" FontSize="11" Margin="0,0,6,0"/>
                    <!-- Subtype filter -->
                    <ComboBox ItemsSource="{x:Static vm:DeckBuilderViewModel.SubtypeOptions}"
                              SelectedItem="{Binding SubtypeFilter}"
                              Width="110" FontSize="11" Margin="0,0,6,0"/>
                    <!-- Set filter -->
                    <ComboBox ItemsSource="{Binding SetOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SetFilter}"
                              Width="140" FontSize="11" Margin="0,0,6,0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushSubtext}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <!-- Tag filter -->
                    <ComboBox ItemsSource="{Binding TagOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding TagFilter}"
                              Width="120" FontSize="11" Margin="0,0,6,0"/>
                    <!-- Only owned -->
                    <CheckBox IsChecked="{Binding OnlyOwned}"
                              Content="Owned only"
                              Foreground="{StaticResource BrushText}"
                              FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!-- Status -->
                    <TextBlock Text="{Binding BrowserStatus}"
                               Foreground="{StaticResource BrushSubtext}"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Results : grille de cartes façon collection -->
            <ScrollViewer Grid.Row="2" x:Name="ResultsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding BrowserCards}" Margin="0,6"
                              HorizontalAlignment="Center"
                              Width="{Binding ViewportWidth, ElementName=ResultsScroll,
                                      Converter={StaticResource WrapRowWidthConverter}, ConverterParameter=148}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeckBrowserCardVm}">
                            <Border Width="138" Margin="5" CornerRadius="8"
                                    Background="{StaticResource BrushPanel}"
                                    BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InDeck}" Value="True">
                                                <Setter Property="BorderBrush" Value="#ffd700"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Image carte -->
                                    <Grid Height="188" Background="#111122" Cursor="Hand">
                                        <TextBlock Text="…" Foreground="{StaticResource BrushSubtext}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="22"
                                                   Visibility="{Binding IsLoadingImage, Converter={StaticResource BoolToVis}}"/>
                                        <Image Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding ImageUrl, Converter={StaticResource ImageUrlToBitmap}, ConverterParameter=300}"/>
                                        <Button Command="{Binding ShowZoomCommand}"
                                                Style="{StaticResource ZoomButtonStyle}"
                                                Cursor="{DynamicResource MagnifierCursor}"
                                                ToolTip="View full size"/>

                                        <!-- Deck qty badge -->
                                        <Border CornerRadius="9" Background="#0f3460"
                                                Padding="6,2" Margin="4" VerticalAlignment="Top"
                                                HorizontalAlignment="Right" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeckQuantity}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DeckQuantity, StringFormat=×{0}}"
                                                       Foreground="#ffd700" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Owned badge -->
                                        <TextBlock Text="✓ owned" Foreground="#4ecdc4" FontSize="9"
                                                   FontWeight="Bold" Margin="4"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding IsOwned, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                    <!-- Infos -->
                                    <Grid Margin="6,5,6,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource BrushText}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                            <TextBlock Foreground="{StaticResource BrushSubtext}" FontSize="9"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SetName, Mode=OneWay}"/>
                                                <Run Text=" ·"/>
                                                <Run Text="{Binding Number, Mode=OneWay}"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,3">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CmLow}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Image Source="pack://application:,,,/Assets/cardmarket.png"
                                                           Width="11" Height="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CmLow, StringFormat={}{0:F2}€}"
                                                               Foreground="#aaaacc" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TcgLow}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Image Source="pack://application:,,,/Assets/tcgplayer.png"
                                                           Width="11" Height="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TcgLow, StringFormat=${}{0:F2}}"
                                                               Foreground="#aaaacc" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Command="{Binding DataContext.AddCardToDeckCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DkBtn}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,5,0,0"
                                                    ToolTip="Add to deck">
                                                + Deck
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Vertical separator -->
        <Border Grid.Column="1" Background="{StaticResource BrushAccent}"/>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- RIGHT : Admin panel                                               -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Background="#0a0e1a">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BrushAccent}" Padding="12,10">
                <Grid>
                    <TextBlock Text="Saved Decks"
                               Foreground="{StaticResource BrushText}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ImportPtcgoTextCommand}"
                                Style="{StaticResource DkBtn}"
                                Margin="0,0,4,0"
                                ToolTip="Paste a decklist copied from Limitless TCG, TCGPlayer, PTCGL, etc.">
                            📋 Paste
                        </Button>
                        <Button Command="{Binding ImportPtcgoDeckCommand}"
                                Style="{StaticResource DkBtn}"
                                ToolTip="Import a PTCGO/Live .txt deck file">
                            ⬆ File
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Decks list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SavedDecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeckSummaryVm}">
                            <Border BorderThickness="0,0,0,1" BorderBrush="#111830" Padding="10,8">
                                <StackPanel>

                                    <!-- Name row : TextBlock OR TextBox -->
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource BrushText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#111122" Foreground="{StaticResource BrushText}"
                                                 CaretBrush="{StaticResource BrushText}"
                                                 BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                                                 Padding="4,3" FontSize="12">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return"
                                                            Command="{Binding DataContext.CommitRenameCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                <KeyBinding Key="Escape"
                                                            Command="{Binding DataContext.CancelRenameCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>

                                    <!-- Chips Pk/Tr/En/Total -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Foreground="#7a9abf" FontSize="9">
                                                <Run Text="🔵 "/>
                                                <Run Text="{Binding PokemonCount, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text=" Pk"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Foreground="#c49a3a" FontSize="9">
                                                <Run Text="🟡 "/>
                                                <Run Text="{Binding TrainerCount, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text=" Tr"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Foreground="#aa5555" FontSize="9">
                                                <Run Text="⚡ "/>
                                                <Run Text="{Binding EnergyCount, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text=" En"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Foreground="{StaticResource BrushSubtext}" FontSize="9">
                                                <Run Text="{Binding TotalCards, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text="/60"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Date + action buttons -->
                                    <Grid>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yy}}"
                                                   Foreground="{StaticResource BrushSubtext}"
                                                   FontSize="9" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Command="{Binding DataContext.LoadDeckCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AdminBtn}"
                                                    ToolTip="Load this deck" Margin="0,0,3,0">📂</Button>
                                            <Button Command="{Binding DataContext.BeginRenameCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Rename" Margin="0,0,3,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AdminBtn}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                ✏️
                                            </Button>
                                            <Button Command="{Binding DataContext.CommitRenameCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Confirm rename" Margin="0,0,3,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AdminBtn}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                ✔
                                            </Button>
                                            <Button Command="{Binding DataContext.DuplicateDeckCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AdminBtn}"
                                                    ToolTip="Duplicate deck" Margin="0,0,3,0">⧉</Button>
                                            <Button Command="{Binding DataContext.DeleteDeckCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AdminBtn}"
                                                    Foreground="#aa4444"
                                                    ToolTip="Delete deck">✕</Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
